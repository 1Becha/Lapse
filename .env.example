# Copy to .env and adjust. All settings are optional.
PORT=3000
LAPSE_BASE_URL=http://localhost:3000
LAPSE_DATA_DIR=./data

# Protect the UI and API with basic auth (the calendar feed uses its own secret token).
# LAPSE_USER=admin
# LAPSE_PASSWORD=change-me

# Email alerts (owners with an email address and "email" channels).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=Lapse <lapse@example.com>

# Contract PDF import. Default: built-in rules, nothing leaves the server.
# LAPSE_AI_PROVIDER=auto            # auto | anthropic | ollama | none
# ANTHROPIC_API_KEY=                # Claude reads the PDF, including scans
# LAPSE_ANTHROPIC_MODEL=claude-opus-5
# OLLAMA_URL=http://localhost:11434 # local LLM, contract stays on your server
# OLLAMA_MODEL=llama3.1:8b
# LAPSE_MAX_UPLOAD_MB=20

# Discovery
# LAPSE_SCHEDULER=off               # disable scans and alerts (e.g. a public demo)
LAPSE_SCAN_INTERVAL_HOURS=24
LAPSE_CT_MAX_HOSTS=100
