{
  "name": "lapse",
  "version": "0.1.0",
  "description": "Lapse finds what's about to expire, tells you the real deadline to act, and makes sure someone does.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts",
    "typecheck": "tsc",
    "demo:gif": "node --disable-warning=ExperimentalWarning scripts/record-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "nodemailer": "^10.0.10",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2"
  }
}
